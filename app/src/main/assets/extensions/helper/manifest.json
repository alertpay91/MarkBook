{
  "manifest_version": 2,
  "name": "MarkBook helper",
  "version": "1.22",
  "browser_specific_settings": { "gecko": { "id": "helper@markbook.marko" } },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_scripts": [{
    "matches": ["*://m.facebook.com/*", "*://www.facebook.com/*", "*://facebook.com/*"],
    "js": ["helper.js"],
    "run_at": "document_idle"
  }]
}
